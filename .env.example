# Configuración del Servidor Territorial de Crónicos Huarmey II-1
# Copie este archivo como .env y complete los valores. NO use valores de ejemplo en producción.
PORT=3000
NODE_ENV=development

# En producción (NODE_ENV=production), AUTH_SECRET es obligatorio: una cadena aleatoria de al menos 32 caracteres.
# Por ejemplo, genérela con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Credenciales del Administrador Inicial (la clave debe tener al menos 10 caracteres).
# Si deja ADMIN_PASSWORD vacía en desarrollo, el servidor genera una clave temporal y la muestra una sola vez en la consola.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Configuración de Proxy Inverso (true si está detrás de Cloudflare, Nginx, Render o Railway)
TRUST_PROXY=false

# Directorio de datos (opcional, por defecto server/db). Recomendado: una ruta fuera de OneDrive.
# DATA_DIR=/var/data/cronicos
