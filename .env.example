# Configuración del Servidor Territorial de Crónicos Huarmey II-1
# Copie este archivo como .env SOLO para desarrollo local. En producción las variables se cargan en el panel
# del alojamiento (por ejemplo, Render) y NUNCA en el repositorio.
PORT=3000
NODE_ENV=development

# En producción (NODE_ENV=production) AUTH_SECRET es obligatorio: al menos 32 caracteres aleatorios.
# Genérelo con: openssl rand -hex 32
# El servidor se niega a arrancar en producción si este valor sigue con la palabra CAMBIAR
# o si es el secreto de ejemplo que estuvo publicado en versiones anteriores de este archivo.
AUTH_SECRET=CAMBIAR-por-un-secreto-aleatorio-de-64-caracteres

# Administrador inicial (solo se usa al crearlo la primera vez, o con ADMIN_RESET=true).
# El servidor se niega a arrancar en producción si la clave sigue con la palabra CAMBIAR.
ADMIN_USER=admin
ADMIN_PASSWORD=CAMBIAR-por-una-clave-propia-de-12-o-mas-caracteres

# Correo del administrador inicial (para que también pueda recuperar su contraseña por correo)
# ADMIN_EMAIL=admin@su-dominio.pe

# Envío de correos para recuperar la contraseña con un código (opcional; sin esto, el ADMIN restablece las claves).
# Proveedores con API HTTPS: resend o brevo. MAIL_FROM debe usar un dominio verificado en el proveedor.
# MAIL_PROVIDER=resend
# MAIL_API_KEY=CAMBIAR-por-la-clave-del-proveedor
# MAIL_FROM=Crónicos Huarmey <no-responder@su-dominio.pe>
# Vigencia del código en minutos (por defecto 15)
# RECUPERACION_VIGENCIA_MIN=15

# Recuperación de acceso: ADMIN_RESET=true restablece la clave de ADMIN_USER con ADMIN_PASSWORD una sola vez
# por cada clave distinta. Quítelo del entorno después de usarlo.
# ADMIN_RESET=true

# Proxy inverso: true SOLO si el puerto no es accesible directamente (Render, Nginx, Cloudflare).
# Con true y el puerto expuesto, cualquiera puede falsear su IP con X-Forwarded-For.
TRUST_PROXY=true

# Orígenes autorizados por CORS (separados por coma). Vacío = ninguno: la interfaz se sirve desde el mismo origen.
# CORS_ORIGINS=https://app.ejemplo.pe

# Directorio de datos (opcional, por defecto server/db). En producción: el disco persistente.
# DATA_DIR=/var/data/cronicos
