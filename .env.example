# Configuración del Servidor Territorial de Crónicos Huarmey II-1
PORT=3000
NODE_ENV=development

# En producción (NODE_ENV=production), AUTH_SECRET es obligatorio (mínimo 32 caracteres)
AUTH_SECRET=clave-secreta-produccion-minimo-32-caracteres-huarmey-2026

# Credenciales del Administrador Inicial
ADMIN_USER=admin
ADMIN_PASSWORD=Huarmey2026*Seguro

# Configuración de Proxy Inverso (true si está detrás de Cloudflare, Nginx, Render o Railway)
TRUST_PROXY=true

# Directorio de datos (opcional, por defecto server/db)
# DATA_DIR=/var/data/cronicos
